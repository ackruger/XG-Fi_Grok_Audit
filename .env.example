# Public frontend configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Permanent production origin used in QR codes and NFC tags.
# Example: https://xgfi.example.com
VITE_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Edge Function secrets (set in Bolt Secrets or Supabase dashboard — not in .env)
# ---------------------------------------------------------------------------
# APP_URL                = same permanent HTTPS origin as VITE_PUBLIC_APP_URL
# RESEND_API_KEY         = your Resend API key (re_...)
# RESEND_FROM            = verified sender, e.g. "NovusNow <commercial@novusnow.ca>"
# OPENAI_API_KEY         = for AI chat Edge Function (optional if AI disabled)
