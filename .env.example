# Public frontend configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Permanent production origin used in QR codes and NFC tags.
# Example: https://xgfi.example.com
VITE_PUBLIC_APP_URL=

# Edge function secret: the same permanent app URL, used in invitation emails.
# Add this in the Bolt Secrets tab (not in .env, which is frontend-only).
# Name: APP_URL  Value: https://your-app.bolt.host
